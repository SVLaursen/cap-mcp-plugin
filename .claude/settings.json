{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:*)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx cds:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": ["Bash(npm publish:*)", "Bash(git push --force:*)", "Bash(git reset --hard:*)"]
  }
}

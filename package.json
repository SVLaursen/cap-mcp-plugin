{
  "name": "@gavdi/cap-mcp",
  "version": "2.0.0-alpha.0",
  "description": "MCP plugin for SAP CAP - v2 (stateless, CAP-native, opt-in)",
  "keywords": [
    "MCP",
    "CAP",
    "plugin",
    "SAP"
  ],
  "license": "Apache-2.0",
  "author": "Simon Vestergaard Laursen",
  "type": "commonjs",
  "main": "cds-plugin.js",
  "files": [
    "lib/**/*",
    "cds-plugin.js",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:contract": "jest --selectProjects contract",
    "test:behaviour": "jest --selectProjects behaviour",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "demo": "npm run watch --workspace=demo",
    "inspect": "npx @modelcontextprotocol/inspector",
    "check": "npm run typecheck && npm run lint && npm test",
    "conformance": "node scripts/conformance.js"
  },
  "peerDependencies": {
    "@sap/cds": ">=10",
    "express": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/conformance": "^0.1.16",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@sap/cds": "^10.2.2",
    "@sap/cds-dk": "^10.2.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "release-it": "^21.1.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
